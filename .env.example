# =====================================================================
# GitPulse Analytics Environment Configuration Example
# Copy this file to .env before starting docker compose:
#   cp .env.example .env
# =====================================================================

# PostgreSQL Configuration
POSTGRES_DB=gitpulse
POSTGRES_USER=gitpulse_user
POSTGRES_PASSWORD=gitpulse_secret_pass

# Backend API Configuration
ENV=production
API_V1_PREFIX=/api/v1
GEMINI_API_KEY=

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
